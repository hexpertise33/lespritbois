{
  "name": "lespritbois",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "L'Esprit Bois — créateur d'espaces extérieurs. Site vitrine immersif.",
  "scripts": {
    "dev": "npm run lastmod && next dev",
