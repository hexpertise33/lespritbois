    "start": "next start",
    "preview": "npm run lastmod && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run lastmod && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "lastmod": "node scripts/gen-lastmod.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.0",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
